node_modules/
dist/
*.log
.env

# evidence is heavy and may hold client data: runs are not committed by default.
# To publish a run on purpose (for example a SauceDemo portfolio run), use: git add -f <path>
projects/*/evidence/*
!projects/*/evidence/.gitkeep

# but keep the folders themselves
!projects/*/.gitkeep
projects/*/.gitkeep

# sample output from `npm run sample:excel`
projects/*/test-cases/_sample*

# cached LLM step expansions (regenerated on demand)
projects/*/knowledge/expansion-cache.json*
